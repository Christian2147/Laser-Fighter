# Ignore the build directory in the source directory (These are compiled files which can be recreated when the program is packaged)
**/build/
**/dist/
**/main.spec

# Ignore the build directories in the imagescaler directory (These are compiled files which can be recreated when the program is packaged)
tools/imagescaler/build
tools/imagescaler/dist
tools/imagescaler/Main.spec

# Ignore the virtual environment files specific to the users environment and can be recreated
venv/
.idea/
.vscode/

# Ignore Python byte-compiled files
__pycache__/
*.py[cod]

# Ignore Log Files
*deletion_log.txt